APP_NAME=FileVault
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# ── Cryptographic hardening ────────────────────────────────────────────────
# Increase bcrypt cost factor — higher = slower = harder to brute-force hashes.
# 12 is a good balance; increase to 13-14 on faster servers.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Set to 'error' in production — never 'debug' (leaks internals)
LOG_LEVEL=error

# ── Database ───────────────────────────────────────────────────────────────
DB_CONNECTION=sqlite

# ── Session security ──────────────────────────────────────────────────────
# database driver stores sessions server-side (safer than cookies)
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Encrypt session payload at rest (security misconfiguration fix)
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production when serving over HTTPS
SESSION_SECURE_COOKIE=false
# lax protects against CSRF from external links; use 'strict' for maximum security
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Upload limits ──────────────────────────────────────────────────────────
# Also set upload_max_filesize and post_max_size in php.ini to match.
FILE_MAX_SIZE_KB=10240
